{
  "$schema": "../schemas/tokens.schema.json",
  "meta": {
    "name": "Template design",
    "description": "The one design of this template: navy, cream and muted gold, with Old Standard TT for headings and buttons. Editors do not change these; a designer can.",
    "fonts": "Old Standard TT (headings, buttons), Source Sans 3 (body), Ponomar (Church Slavonic ornament lines). All SIL Open Font License, self-hosted in public/assets/fonts."
  },
  "color": {
    "navy": "#174372",
    "navy-deep": "#0f2d4f",
    "navy-ink": "#0b2240",
    "sky": "#7fa3c8",
    "cream": "#fff9dc",
    "paper": "#fdfbf5",
    "paper-alt": "#f6f1e3",
    "gold": "#b08d57",
    "gold-light": "#dcc8a2",
    "gold-dark": "#7f6136",
    "ink": "#1b2432",
    "ink-soft": "#3a4556",
    "muted": "#5d6778",
    "line": "#e6dcc5",
    "line-strong": "#d3c39f",
    "white": "#ffffff",
    "success": "#2f6b4f",
    "warning": "#8a5a12"
  },
  "semantic": {
    "brand": "{color.navy}",
    "brand-strong": "{color.navy-ink}",
    "accent": "{color.gold}",
    "accent-strong": "{color.gold-dark}",
    "accent-soft": "{color.gold-light}",
    "surface": "{color.paper}",
    "surface-alt": "{color.paper-alt}",
    "surface-highlight": "{color.cream}",
    "surface-raised": "{color.white}",
    "surface-inverse": "{color.navy-ink}",
    "text": "{color.ink}",
    "text-soft": "{color.ink-soft}",
    "text-muted": "{color.muted}",
    "text-inverse": "{color.cream}",
    "heading": "{color.navy-ink}",
    "link": "{color.navy}",
    "link-hover": "{color.gold-dark}",
    "border": "{color.line}",
    "border-strong": "{color.line-strong}",
    "focus": "{color.gold}"
  },
  "font": {
    "serif": "\"Old Standard TT\", \"Old Standard\", Georgia, \"Times New Roman\", serif",
    "sans": "\"Source Sans 3\", \"Source Sans Pro\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "slavonic": "\"Ponomar\", \"Old Standard TT\", Georgia, serif"
  },
  "font-weight": {
    "regular": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },
  "font-size": {
    "2xs": "0.75rem",
    "xs": "0.8125rem",
    "sm": "0.9375rem",
    "base": "1.0625rem",
    "md": "1.1875rem",
    "lg": "1.375rem",
    "xl": "1.625rem",
    "2xl": "clamp(1.75rem, 1.35rem + 1.4vw, 2.25rem)",
    "3xl": "clamp(2.125rem, 1.6rem + 2vw, 3rem)",
    "4xl": "clamp(2.5rem, 1.75rem + 3vw, 3.875rem)",
    "display": "clamp(2.875rem, 1.9rem + 4.2vw, 4.75rem)"
  },
  "line-height": {
    "tight": "1.1",
    "snug": "1.3",
    "normal": "1.55",
    "relaxed": "1.7"
  },
  "letter-spacing": {
    "tight": "-0.01em",
    "normal": "0",
    "wide": "0.04em",
    "caps": "0.16em"
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "7": "2rem",
    "8": "2.5rem",
    "9": "3rem",
    "10": "4rem",
    "11": "5rem",
    "12": "6rem",
    "13": "8rem"
  },
  "radius": {
    "none": "0",
    "sm": "3px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(11, 34, 64, 0.06)",
    "md": "0 10px 30px -18px rgba(11, 34, 64, 0.35)",
    "lg": "0 24px 60px -30px rgba(11, 34, 64, 0.45)"
  },
  "layout": {
    "container": "1240px",
    "container-narrow": "780px",
    "container-wide": "1400px",
    "gutter": "clamp(1.25rem, 0.6rem + 2.6vw, 2.5rem)",
    "grid-gap": "clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem)",
    "section-space": "clamp(4rem, 2.6rem + 5vw, 7rem)",
    "section-space-tight": "clamp(2.75rem, 2rem + 3vw, 4.5rem)",
    "header-height": "100px",
    "header-height-compact": "68px",
    "logo-height": "74px",
    "logo-height-compact": "48px",
    "logo-height-mobile": "46px"
  },
  "motion": {
    "fast": "150ms",
    "base": "240ms",
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  },
  "fontImports": [],
  "fontFaces": [
    {
      "family": "Old Standard TT",
      "src": "/assets/fonts/old-standard-tt-latin-400-normal.woff2",
      "style": "normal",
      "weight": "400",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
      "preload": true
    },
    {
      "family": "Old Standard TT",
      "src": "/assets/fonts/old-standard-tt-cyrillic-400-normal.woff2",
      "style": "normal",
      "weight": "400",
      "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
    },
    {
      "family": "Old Standard TT",
      "src": "/assets/fonts/old-standard-tt-latin-400-italic.woff2",
      "style": "italic",
      "weight": "400",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
    },
    {
      "family": "Old Standard TT",
      "src": "/assets/fonts/old-standard-tt-cyrillic-400-italic.woff2",
      "style": "italic",
      "weight": "400",
      "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
    },
    {
      "family": "Old Standard TT",
      "src": "/assets/fonts/old-standard-tt-latin-700-normal.woff2",
      "style": "normal",
      "weight": "700",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
    },
    {
      "family": "Old Standard TT",
      "src": "/assets/fonts/old-standard-tt-cyrillic-700-normal.woff2",
      "style": "normal",
      "weight": "700",
      "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
    },
    {
      "family": "Source Sans 3",
      "src": "/assets/fonts/source-sans-3-latin-wght-normal.woff2",
      "style": "normal",
      "weight": "300 800",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
      "preload": true
    },
    {
      "family": "Source Sans 3",
      "src": "/assets/fonts/source-sans-3-cyrillic-wght-normal.woff2",
      "style": "normal",
      "weight": "300 800",
      "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
    },
    {
      "family": "Source Sans 3",
      "src": "/assets/fonts/source-sans-3-latin-wght-italic.woff2",
      "style": "italic",
      "weight": "300 800",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
    },
    {
      "family": "Source Sans 3",
      "src": "/assets/fonts/source-sans-3-cyrillic-wght-italic.woff2",
      "style": "italic",
      "weight": "300 800",
      "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
    },
    {
      "family": "Ponomar",
      "src": "/assets/fonts/ponomar-cyrillic-400-normal.woff2",
      "style": "normal",
      "weight": "400"
    }
  ],
  "font-role": {
    "heading": "{font.serif}",
    "button": "{font.serif}",
    "ornament": "{font.slavonic}",
    "body": "{font.sans}"
  }
}
