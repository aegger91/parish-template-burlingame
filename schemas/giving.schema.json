{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "giving.schema.json",
  "title": "Giving",
  "description": "content/giving.json: the donation form and membership dues.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "description": "Payment provider name, e.g. \"stripe\". Connect it in ParishSite.handlers.donate."
    },
    "endpoint": {
      "type": "string",
      "description": "Where the form posts. Empty: sample mode."
    },
    "note": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "amounts": {
      "type": "object",
      "properties": {
        "once": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "monthly": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "funds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "needsReview": {
            "type": "string",
            "description": "Note for editors. Never shown on the site."
          },
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^[a-z]{2,3}_locked$": {
            "type": "boolean",
            "description": "Marks the translations in this object as approved by a person."
          }
        }
      },
      "description": "What a gift can go to."
    },
    "dues": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "note": {
          "$ref": "common.schema.json#/$defs/markdown"
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "note": {
                "$ref": "common.schema.json#/$defs/text"
              }
            },
            "required": [
              "id",
              "label",
              "amount"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "funds"
  ],
  "additionalProperties": false
}
