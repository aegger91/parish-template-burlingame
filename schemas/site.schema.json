{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.schema.json",
  "title": "Site",
  "description": "content/site.json: parish details, languages and the optional features.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id",
      "description": "Short parish id."
    },
    "url": {
      "$ref": "common.schema.json#/$defs/url"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Parish name."
    },
    "location": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Town and state, shown under the name."
    },
    "accent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "lang": {
          "$ref": "common.schema.json#/$defs/localeCode"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "The name in Church Slavonic or another language, shown as a second line."
    },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "url": {
          "$ref": "common.schema.json#/$defs/url"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone, e.g. \"America/Los_Angeles\"."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO currency code for prices."
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/localeCode"
          },
          "label": {
            "type": "string",
            "description": "Short label for the switcher, e.g. \"EN\"."
          },
          "name": {
            "type": "string",
            "description": "Name in that language."
          },
          "ogLocale": {
            "type": "string"
          },
          "dir": {
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "weekStart": {
            "enum": [
              0,
              1
            ],
            "description": "0 Sunday, 1 Monday."
          }
        },
        "required": [
          "code",
          "label",
          "name"
        ],
        "additionalProperties": false
      },
      "description": "Site languages. The first is the default."
    },
    "sourceLocale": {
      "$ref": "common.schema.json#/$defs/localeCode"
    },
    "features": {
      "type": "object",
      "properties": {
        "livestream": {
          "type": "boolean",
          "description": "Livestream page, live badge and sermons.",
          "default": false
        },
        "store": {
          "type": "boolean",
          "description": "Parish store, product pages and cart.",
          "default": false
        },
        "serviceRequests": {
          "type": "boolean",
          "description": "Request a Service page.",
          "default": false
        },
        "commemorations": {
          "type": "boolean",
          "description": "Commemoration notes and candles.",
          "default": false
        },
        "getInvolved": {
          "type": "boolean",
          "description": "Events, volunteering and needs from OrthodoxConnect.",
          "default": false
        },
        "newsletter": {
          "type": "boolean",
          "description": "Newsletter sign-up in the footer (OrthodoxConnect).",
          "default": false
        }
      },
      "additionalProperties": false,
      "description": "Switch optional parts of the site on or off."
    },
    "calendar": {
      "type": "object",
      "properties": {
        "style": {
          "enum": [
            "julian",
            "revised-julian",
            "gregorian"
          ],
          "description": "Church calendar for feasts."
        },
        "showOldStyle": {
          "type": "boolean",
          "description": "Show the Old Style date (Julian only).",
          "default": true
        }
      },
      "required": [
        "style"
      ],
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          },
          "required": [
            "street",
            "city"
          ],
          "additionalProperties": false
        },
        "phone": {
          "$ref": "common.schema.json#/$defs/phone"
        },
        "email": {
          "$ref": "common.schema.json#/$defs/email"
        },
        "directionsUrl": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "mapEmbedUrl": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "officeHours": {
          "$ref": "common.schema.json#/$defs/text"
        }
      },
      "required": [
        "address"
      ],
      "additionalProperties": false
    },
    "social": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "icon": {
            "$ref": "common.schema.json#/$defs/iconName"
          }
        },
        "required": [
          "id",
          "label",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "livestream": {
      "type": "object",
      "properties": {
        "embedUrl": {
          "type": "string",
          "description": "Player URL, loaded only when someone presses play."
        },
        "watchUrl": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "leadMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Show \"Live now\" this many minutes before a streamed service."
        },
        "statusUrl": {
          "type": "string"
        },
        "poster": {
          "$ref": "common.schema.json#/$defs/image"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/link"
          }
        }
      },
      "additionalProperties": false
    },
    "orthodoxConnect": {
      "type": "object",
      "properties": {
        "parishId": {
          "type": "string",
          "description": "Parish id on OrthodoxConnect."
        },
        "appUrl": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "sampleFeed": {
          "type": "string",
          "description": "Sample feed file under content/."
        },
        "newsletterListId": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "properties": {
            "join": {
              "type": "string",
              "description": "URL template. {appUrl}, {parishId} and {id} are filled in."
            },
            "createEvent": {
              "type": "string",
              "description": "URL template. {appUrl}, {parishId} and {id} are filled in."
            },
            "postNeed": {
              "type": "string",
              "description": "URL template. {appUrl}, {parishId} and {id} are filled in."
            },
            "item": {
              "type": "string",
              "description": "URL template. {appUrl}, {parishId} and {id} are filled in."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "parishId",
        "appUrl"
      ],
      "additionalProperties": false
    },
    "forms": {
      "type": "object",
      "properties": {
        "contactEndpoint": {
          "type": "string",
          "description": "Where the contact form posts. Empty: sample mode."
        }
      },
      "additionalProperties": false
    },
    "logo": {
      "type": "object",
      "properties": {
        "image": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/path"
            },
            {
              "$ref": "common.schema.json#/$defs/url"
            }
          ],
          "description": "Logo file. Any shape works; the header sizes it by height."
        },
        "favicon": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "icon": {
          "$ref": "common.schema.json#/$defs/path"
        }
      },
      "required": [
        "image"
      ],
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "properties": {
        "siteName": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "image": {
          "$ref": "common.schema.json#/$defs/path"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "locales",
    "sourceLocale",
    "features",
    "contact",
    "logo"
  ],
  "additionalProperties": false
}
