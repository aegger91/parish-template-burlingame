{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news.schema.json",
  "title": "News",
  "description": "content/news.json: news items, newest first.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "needsReview": {
            "type": "string",
            "description": "Note for editors. Never shown on the site."
          },
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "category": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "Category id."
          },
          "featured": {
            "type": "boolean"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "body": {
            "$ref": "common.schema.json#/$defs/markdown"
          },
          "bodyLang": {
            "$ref": "common.schema.json#/$defs/localeCode"
          },
          "image": {
            "$ref": "common.schema.json#/$defs/image"
          },
          "gallery": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "Album id from galleries.json."
          },
          "videos": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/link"
            }
          }
        },
        "required": [
          "id",
          "date",
          "title"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^[a-z]{2,3}_locked$": {
            "type": "boolean",
            "description": "Marks the translations in this object as approved by a person."
          }
        }
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
